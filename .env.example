# Copy to .env and fill in your own values. Never commit or share .env.
DB_ENGINE=postgres

# PostgreSQL / Neon (required when DB_ENGINE=postgres)
NEON_HOST=your-neon-host
NEON_PORT=5432
NEON_DB=your-database-name
NEON_USER=your-database-user
NEON_PASSWORD=replace-with-your-database-password
NEON_SSLMODE=require

# MySQL (required when DB_ENGINE=mysql)
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=your-database-name
DB_USER=your-database-user
DB_PASSWORD=replace-with-your-database-password
DB_SSL_DISABLED=false
# MySQL pool for simultaneous dashboard/API requests (adjust to provider connection limits).
DB_POOL_SIZE=10

# App security: replace with a unique random secret and your admin password hash.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-a-generated-password-hash
COOKIE_SECURE=true
FLASK_ENV=production

# Optional Apify collection. Keep blank until an Actor has been reviewed.
APIFY_API_TOKEN=

# Separate job-seeker login (generate the hash with werkzeug.security.generate_password_hash)
USER_USERNAME=jobseeker
USER_PASSWORD_HASH=
# Job portal Actor configuration. Keep approval flags false until you verify
# the Actor's current input schema, pricing, terms, and your permission to use it.
# APIFY_INPUT_<KEY> must be a single-line JSON object matching that Actor's Input tab.
# Candidate Actor IDs and built-in input templates are in collectors/source_catalog.py and scripts/run_source_apify.py.
# Every Actor still requires a pricing/terms review and APIFY_ACCESS_APPROVED_<KEY>=true before use.
# Built-in templates are starting points; confirm the Actor input schema in Apify before approval.
APIFY_ACTOR_NAUKRI=
APIFY_INPUT_NAUKRI=
APIFY_ACCESS_APPROVED_NAUKRI=false
APIFY_ACTOR_INDEED=
APIFY_INPUT_INDEED=
APIFY_ACCESS_APPROVED_INDEED=false
